<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Abandoned Cart: Tree View -->
    <record id="view_ecc_abandoned_cart_tree" model="ir.ui.view">
        <field name="name">ecc.abandoned.cart.tree</field>
        <field name="model">ecc.abandoned.cart</field>
        <field name="arch" type="xml">
            <tree string="Abandoned Carts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="cart_total" sum="Total"/>
                <field name="cart_items_count"/>
                <field name="abandoned_date"/>
                <field name="ai_recovery_probability" widget="percentage"/>
                <field name="recovery_email_sent"/>
                <field name="recovered"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'abandoned'"
                       decoration-warning="state == 'email_sent'"
                       decoration-success="state == 'recovered'"
                       decoration-danger="state == 'lost'"/>
            </tree>
        </field>
    </record>

    <!-- Abandoned Cart: Form View -->
    <record id="view_ecc_abandoned_cart_form" model="ir.ui.view">
        <field name="name">ecc.abandoned.cart.form</field>
        <field name="model">ecc.abandoned.cart</field>
        <field name="arch" type="xml">
            <form string="Abandoned Cart">
                <header>
                    <button name="action_send_recovery_email" type="object"
                            string="Send Recovery Email" class="oe_highlight"
                            invisible="state in ('email_sent', 'recovered', 'lost')"/>
                    <button name="action_mark_recovered" type="object"
                            string="Mark Recovered"
                            invisible="state in ('recovered', 'lost')"/>
                    <button name="action_mark_lost" type="object"
                            string="Mark Lost"
                            invisible="state in ('recovered', 'lost')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="abandoned,email_sent,recovered,lost"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="recovery_email_sent" invisible="1"/>
                        <field name="recovered" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cart_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cart_items_count"/>
                        </group>
                        <group>
                            <field name="abandoned_date"/>
                            <field name="recovery_email_date"/>
                            <field name="recovered_date"/>
                            <field name="ai_recovery_probability" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Abandoned Cart: Search View -->
    <record id="view_ecc_abandoned_cart_search" model="ir.ui.view">
        <field name="name">ecc.abandoned.cart.search</field>
        <field name="model">ecc.abandoned.cart</field>
        <field name="arch" type="xml">
            <search string="Abandoned Carts">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_abandoned" string="Abandoned"
                        domain="[('state', '=', 'abandoned')]"/>
                <filter name="filter_email_sent" string="Email Sent"
                        domain="[('state', '=', 'email_sent')]"/>
                <filter name="filter_recovered" string="Recovered"
                        domain="[('state', '=', 'recovered')]"/>
                <filter name="filter_lost" string="Lost"
                        domain="[('state', '=', 'lost')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Abandoned Cart: Action -->
    <record id="action_ecc_abandoned_cart" model="ir.actions.act_window">
        <field name="name">Abandoned Carts</field>
        <field name="res_model">ecc.abandoned.cart</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ecc_abandoned_cart_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new abandoned cart record
            </p>
        </field>
    </record>
</odoo>
